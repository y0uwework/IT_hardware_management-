// Hardware Management System — Prisma schema (Microsoft SQL Server)
//
// IMPORTANT: The `User` model maps the organization's EXISTING `users` table.
// It is NOT created by HMS migrations (see docs/schema-mapping.md and
// prisma/migrations/README.md). Field names/types below are ASSUMPTIONS that
// must be verified against the real table before the first production migration.
// Every *UserId foreign key uses Int to match the assumed `users.id INT IDENTITY`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Existing employee master (reuse — do not recreate)
// ─────────────────────────────────────────────────────────────

model User {
  id           Int     @id @default(autoincrement())
  employeeCode String  @map("employee_code") @db.NVarChar(50)
  fullName     String  @map("full_name") @db.NVarChar(200)
  email        String? @db.NVarChar(255)
  department   String? @db.NVarChar(100)
  designation  String? @db.NVarChar(100)
  location     String? @db.NVarChar(100)
  managerId    Int?    @map("manager_id")
  isActive     Boolean @map("is_active")

  manager  User?  @relation("UserManager", fields: [managerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reports  User[] @relation("UserManager")

  userRoles           UserRole[]           @relation("UserRoleUser")
  rolesAssigned       UserRole[]           @relation("UserRoleAssignedBy")
  requests            HardwareRequest[]    @relation("RequestRequester")
  approvalTasks       ApprovalTask[]       @relation("TaskApprover")
  approvalActions     ApprovalHistory[]    @relation("HistoryActor")
  assignments         AssetAssignment[]    @relation("AssignmentUser")
  assignmentsIssued   AssetAssignment[]    @relation("AssignmentIssuedBy")
  assignmentsReceived AssetAssignment[]    @relation("AssignmentReturnedTo")
  notifications       Notification[]
  auditLogs           AuditLog[]
  itReviews           HardwareRequestItem[] @relation("ItemReviewedBy")
  reservationsMade    InventoryReservation[] @relation("ReservationCreatedBy")
  movementsMade       InventoryMovement[]   @relation("MovementCreatedBy")
  assetsCreated       Asset[]               @relation("AssetCreatedBy")
  workflowsCreated    ApprovalWorkflow[]    @relation("WorkflowCreatedBy")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────
// Authorization
// ─────────────────────────────────────────────────────────────

model Permission {
  id            Int      @id @default(autoincrement())
  permissionKey String   @unique @map("permission_key") @db.NVarChar(100)
  module        String   @db.NVarChar(100)
  description   String   @db.NVarChar(500)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime2
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime2

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id          Int      @id @default(autoincrement())
  roleName    String   @unique @map("role_name") @db.NVarChar(100)
  description String?  @db.NVarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime2

  userRoles       UserRole[]
  rolePermissions RolePermission[]
  workflowStages  ApprovalWorkflowStage[]

  @@map("roles")
}

model UserRole {
  id               Int      @id @default(autoincrement())
  userId           Int      @map("user_id")
  roleId           Int      @map("role_id")
  assignedByUserId Int?     @map("assigned_by_user_id")
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.DateTime2

  user       User  @relation("UserRoleUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedBy User? @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int      @map("role_id")
  permissionId Int      @map("permission_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime2

  role       Role       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────
// Hardware masters
// ─────────────────────────────────────────────────────────────

model HardwareCategory {
  id           Int      @id @default(autoincrement())
  code         String   @unique @db.NVarChar(50)
  name         String   @db.NVarChar(150)
  description  String?  @db.NVarChar(500)
  /// true = individually tracked assets (laptops); false = quantity-tracked stock (cables, mice)
  isSerialized Boolean  @default(true) @map("is_serialized")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime2

  requestItems HardwareRequestItem[]
  stock        InventoryStock[]
  reservations InventoryReservation[]
  movements    InventoryMovement[]
  assets       Asset[]

  @@map("hardware_categories")
}

model Warehouse {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.NVarChar(50)
  name      String   @db.NVarChar(150)
  location  String?  @db.NVarChar(200)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime2

  stock        InventoryStock[]
  reservations InventoryReservation[]
  movements    InventoryMovement[]
  assets       Asset[]

  @@map("warehouses")
}

// ─────────────────────────────────────────────────────────────
// Requests and approvals
// ─────────────────────────────────────────────────────────────

model HardwareRequest {
  id              Int       @id @default(autoincrement())
  requestNumber   String    @unique @map("request_number") @db.NVarChar(30)
  requesterUserId Int       @map("requester_user_id")
  requestType     String    @map("request_type") @db.NVarChar(50)
  purpose         String    @db.NVarChar(500)
  justification   String?   @db.NVarChar(Max)
  priority        String    @db.NVarChar(20)
  requiredDate    DateTime? @map("required_date") @db.Date
  costCentre      String?   @map("cost_centre") @db.NVarChar(100)
  status          String    @db.NVarChar(40)
  workflowId      Int?      @map("workflow_id")
  submittedAt     DateTime? @map("submitted_at") @db.DateTime2
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime2
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime2

  requester User              @relation("RequestRequester", fields: [requesterUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workflow  ApprovalWorkflow? @relation(fields: [workflowId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items     HardwareRequestItem[]
  tasks     ApprovalTask[]
  history   ApprovalHistory[]

  @@index([requesterUserId])
  @@index([status])
  @@index([createdAt])
  @@map("hardware_requests")
}

model HardwareRequestItem {
  id                     Int       @id @default(autoincrement())
  hardwareRequestId      Int       @map("hardware_request_id")
  categoryId             Int       @map("category_id")
  quantity               Int
  requestedSpecification String    @map("requested_specification") @db.NVarChar(Max)
  approvedSpecification  String?   @map("approved_specification") @db.NVarChar(Max)
  estimatedUnitPrice     Decimal?  @map("estimated_unit_price") @db.Decimal(18, 2)
  fulfilledQuantity      Int       @default(0) @map("fulfilled_quantity")
  procurementQuantity    Int       @default(0) @map("procurement_quantity")
  fulfilmentStatus       String    @map("fulfilment_status") @db.NVarChar(40)
  itReviewComments       String?   @map("it_review_comments") @db.NVarChar(Max)
  reviewedByUserId       Int?      @map("reviewed_by_user_id")
  reviewedAt             DateTime? @map("reviewed_at") @db.DateTime2

  request      HardwareRequest        @relation(fields: [hardwareRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category     HardwareCategory       @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewedBy   User?                  @relation("ItemReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reservations InventoryReservation[]
  assignments  AssetAssignment[]

  @@index([hardwareRequestId])
  @@map("hardware_request_items")
}

model ApprovalWorkflow {
  id              Int       @id @default(autoincrement())
  workflowKey     String    @map("workflow_key") @db.NVarChar(100)
  name            String    @db.NVarChar(150)
  version         Int
  /// null = applies to any request type
  requestType     String?   @map("request_type") @db.NVarChar(50)
  /// null = applies to any department
  department      String?   @db.NVarChar(100)
  minAmount       Decimal?  @map("min_amount") @db.Decimal(18, 2)
  maxAmount       Decimal?  @map("max_amount") @db.Decimal(18, 2)
  /// Higher priority wins when several workflows match
  priority        Int       @default(0)
  isActive        Boolean   @default(true) @map("is_active")
  createdByUserId Int?      @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime2

  createdBy User?                   @relation("WorkflowCreatedBy", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stages    ApprovalWorkflowStage[]
  requests  HardwareRequest[]

  @@unique([workflowKey, version])
  @@map("approval_workflows")
}

model ApprovalWorkflowStage {
  id           Int     @id @default(autoincrement())
  workflowId   Int     @map("workflow_id")
  /// Stages sharing the same order run in parallel; all must approve.
  stageOrder   Int     @map("stage_order")
  name         String  @db.NVarChar(150)
  /// MANAGER = requester's manager; ROLE = any active holder of roleId
  approverType String  @map("approver_type") @db.NVarChar(30)
  roleId       Int?    @map("role_id")
  dueDays      Int     @default(3) @map("due_days")

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role     Role?            @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tasks    ApprovalTask[]

  @@index([workflowId])
  @@map("approval_workflow_stages")
}

model ApprovalTask {
  id                Int       @id @default(autoincrement())
  hardwareRequestId Int       @map("hardware_request_id")
  stageId           Int       @map("stage_id")
  approverUserId    Int       @map("approver_user_id")
  /// Increments each time the request is re-submitted after "Returned for Changes"
  cycle             Int       @default(1)
  status            String    @db.NVarChar(30)
  dueAt             DateTime? @map("due_at") @db.DateTime2
  actedAt           DateTime? @map("acted_at") @db.DateTime2
  comments          String?   @db.NVarChar(Max)
  delegatedFromUserId Int?    @map("delegated_from_user_id")
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime2

  request  HardwareRequest       @relation(fields: [hardwareRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  stage    ApprovalWorkflowStage @relation(fields: [stageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approver User                  @relation("TaskApprover", fields: [approverUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([approverUserId])
  @@index([status])
  @@index([hardwareRequestId])
  @@map("approval_tasks")
}

model ApprovalHistory {
  id                Int      @id @default(autoincrement())
  hardwareRequestId Int      @map("hardware_request_id")
  taskId            Int?     @map("task_id")
  stageName         String?  @map("stage_name") @db.NVarChar(150)
  workflowVersion   Int?     @map("workflow_version")
  actorUserId       Int      @map("actor_user_id")
  /// Submitted, Approved, Rejected, Returned, Cancelled, IT Reviewed, ...
  action            String   @db.NVarChar(40)
  comments          String?  @db.NVarChar(Max)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime2

  request HardwareRequest @relation(fields: [hardwareRequestId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  actor   User            @relation("HistoryActor", fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([hardwareRequestId])
  @@map("approval_history")
}

// ─────────────────────────────────────────────────────────────
// Inventory and assets
// ─────────────────────────────────────────────────────────────

model InventoryStock {
  id                    Int      @id @default(autoincrement())
  categoryId            Int      @map("category_id")
  warehouseId           Int      @map("warehouse_id")
  quantityAvailable     Int      @default(0) @map("quantity_available")
  quantityReserved      Int      @default(0) @map("quantity_reserved")
  quantityIssued        Int      @default(0) @map("quantity_issued")
  quantityDamaged       Int      @default(0) @map("quantity_damaged")
  quantityUnderRepair   Int      @default(0) @map("quantity_under_repair")
  updatedAt             DateTime @updatedAt @map("updated_at") @db.DateTime2

  category  HardwareCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([categoryId, warehouseId])
  @@index([warehouseId])
  @@map("inventory_stock")
}

model InventoryReservation {
  id              Int       @id @default(autoincrement())
  requestItemId   Int       @map("request_item_id")
  categoryId      Int       @map("category_id")
  warehouseId     Int       @map("warehouse_id")
  /// Set for serialized categories; null for quantity-tracked stock
  assetId         Int?      @map("asset_id")
  quantity        Int
  status          String    @db.NVarChar(20)
  expiresAt       DateTime? @map("expires_at") @db.DateTime2
  createdByUserId Int       @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime2
  closedAt        DateTime? @map("closed_at") @db.DateTime2

  requestItem HardwareRequestItem @relation(fields: [requestItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category    HardwareCategory    @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse   Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asset       Asset?              @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy   User                @relation("ReservationCreatedBy", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([requestItemId])
  @@index([status])
  @@index([assetId])
  @@map("inventory_reservations")
}

model InventoryMovement {
  id              Int      @id @default(autoincrement())
  categoryId      Int      @map("category_id")
  warehouseId     Int      @map("warehouse_id")
  assetId         Int?     @map("asset_id")
  movementType    String   @map("movement_type") @db.NVarChar(30)
  quantity        Int
  reason          String?  @db.NVarChar(500)
  referenceType   String?  @map("reference_type") @db.NVarChar(50)
  referenceId     Int?     @map("reference_id")
  createdByUserId Int      @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime2

  category  HardwareCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  asset     Asset?           @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy User             @relation("MovementCreatedBy", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([categoryId, warehouseId])
  @@index([createdAt])
  @@map("inventory_movements")
}

model Asset {
  id              Int       @id @default(autoincrement())
  assetTag        String    @unique @map("asset_tag") @db.NVarChar(50)
  serialNumber    String?   @map("serial_number") @db.NVarChar(100)
  categoryId      Int       @map("category_id")
  manufacturer    String?   @db.NVarChar(100)
  model           String?   @db.NVarChar(150)
  specification   String?   @db.NVarChar(Max)
  purchaseDate    DateTime? @map("purchase_date") @db.Date
  purchaseCost    Decimal?  @map("purchase_cost") @db.Decimal(18, 2)
  warrantyEndDate DateTime? @map("warranty_end_date") @db.Date
  warehouseId     Int?      @map("warehouse_id")
  condition       String    @db.NVarChar(30)
  status          String    @db.NVarChar(30)
  notes           String?   @db.NVarChar(Max)
  createdByUserId Int       @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime2
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime2

  category     HardwareCategory       @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  warehouse    Warehouse?             @relation(fields: [warehouseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy    User                   @relation("AssetCreatedBy", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignments  AssetAssignment[]
  reservations InventoryReservation[]
  movements    InventoryMovement[]

  @@index([serialNumber])
  @@index([status])
  @@index([categoryId])
  @@map("assets")
}

model AssetAssignment {
  id                 Int       @id @default(autoincrement())
  assetId            Int       @map("asset_id")
  userId             Int       @map("user_id")
  requestItemId      Int?      @map("request_item_id")
  assignedAt         DateTime  @default(now()) @map("assigned_at") @db.DateTime2
  conditionAtIssue   String    @map("condition_at_issue") @db.NVarChar(30)
  accessories        String?   @db.NVarChar(500)
  issueNotes         String?   @map("issue_notes") @db.NVarChar(Max)
  issuedByUserId     Int       @map("issued_by_user_id")
  acknowledgedAt     DateTime? @map("acknowledged_at") @db.DateTime2
  returnedAt         DateTime? @map("returned_at") @db.DateTime2
  conditionAtReturn  String?   @map("condition_at_return") @db.NVarChar(30)
  returnAccessories  String?   @map("return_accessories") @db.NVarChar(500)
  inspectionNotes    String?   @map("inspection_notes") @db.NVarChar(Max)
  returnedToUserId   Int?      @map("returned_to_user_id")
  /// true while the assignment is open; used for the "one active assignment per asset" filtered index
  isActive           Boolean   @default(true) @map("is_active")

  asset       Asset                @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user        User                 @relation("AssignmentUser", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestItem HardwareRequestItem? @relation(fields: [requestItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  issuedBy    User                 @relation("AssignmentIssuedBy", fields: [issuedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  returnedTo  User?                @relation("AssignmentReturnedTo", fields: [returnedToUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
  @@index([assetId])
  @@index([requestItemId])
  @@map("asset_assignments")
}

// ─────────────────────────────────────────────────────────────
// Shared application records
// ─────────────────────────────────────────────────────────────

model Notification {
  id              Int       @id @default(autoincrement())
  recipientUserId Int       @map("recipient_user_id")
  eventType       String    @map("event_type") @db.NVarChar(60)
  title           String    @db.NVarChar(200)
  body            String?   @db.NVarChar(1000)
  link            String?   @db.NVarChar(300)
  readAt          DateTime? @map("read_at") @db.DateTime2
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime2

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([recipientUserId, readAt])
  @@map("notifications")
}

model AuditLog {
  id            BigInt   @id @default(autoincrement())
  actorUserId   Int?     @map("actor_user_id")
  action        String   @db.NVarChar(80)
  entityType    String   @map("entity_type") @db.NVarChar(60)
  entityId      String   @map("entity_id") @db.NVarChar(60)
  beforeJson    String?  @map("before_json") @db.NVarChar(Max)
  afterJson     String?  @map("after_json") @db.NVarChar(Max)
  correlationId String?  @map("correlation_id") @db.NVarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime2

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}
