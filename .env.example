# Copy to .env.local (or .env) and fill in real values. Never commit real credentials.
# Precedence: shell environment > .env.local > .env (same for the app, migrations and seeds).

# SQL Server connection (read by config/db-config.mjs)
DB_SERVER=localhost
# Named instance instead: DB_SERVER=localhost\SQLEXPRESS (DB_PORT is then ignored)
DB_PORT=1433
DB_DATABASE=IT_Assest_manager
# "sql" = SQL Server login (DB_USER / DB_PASSWORD); "windows" = Windows auth (npm install msnodesqlv8)
DB_AUTH=sql
DB_USER=it_asset_app
DB_PASSWORD="CHANGE_ME"
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Optional: a stronger login used only by `npm run migrate` (can create the database and alter tables).
# When unset, migrations use DB_USER / DB_PASSWORD.
# DB_MIGRATE_USER=sa
# DB_MIGRATE_PASSWORD="CHANGE_ME"

# Secret used to sign the session cookie. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Session lifetime in hours
SESSION_TTL_HOURS=8

# "dev" enables sign-in by employee code only (local development ONLY).
# Set to "external" once the organization's existing authentication is integrated in lib/auth.ts.
AUTH_MODE=dev

NODE_ENV=development

# RBAC switch. true = enforce role/permission checks on every page, API and action.
# false = RBAC is off for the whole app (any signed-in user can do everything). Never use false in production.
RunAuthrization=true
