# SQL Server connection. Copy to .env and fill in real values. Never commit real credentials.
DB_SERVER=localhost
DB_PORT=1433
DB_DATABASE=HardwareManagementDB
# "sql" = SQL Server login (DB_USER / DB_PASSWORD)
DB_AUTH=sql
DB_USER=HMS_USER
DB_PASSWORD="CHANGE_ME"
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# Prisma reads only DATABASE_URL; it is built from the DB_* values above (Prisma and Next.js expand ${VAR}).
# The password is wrapped in {} so characters like ; = @ don't break the connection string.
DATABASE_URL="sqlserver://${DB_SERVER}:${DB_PORT};database=${DB_DATABASE};user=${DB_USER};password={${DB_PASSWORD}};encrypt=${DB_ENCRYPT};trustServerCertificate=${DB_TRUST_SERVER_CERTIFICATE}"

# Secret used to sign the session cookie. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Session lifetime in hours
SESSION_TTL_HOURS=8

# "dev" enables sign-in by employee code only (local development ONLY).
# Set to "external" once the organization's existing authentication is integrated in lib/auth.ts.
AUTH_MODE=dev

NODE_ENV=development
